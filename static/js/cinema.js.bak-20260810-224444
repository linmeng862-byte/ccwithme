// =========== 片库开关 ===========

function _cinemaOpenLibrary() {
  var backdrop = $('cinemaLibraryBackdrop');
  var panel = $('cinemaLibrary');
  if (!backdrop) return;
  backdrop.style.display = 'flex';
  // 强制回流后播放动画
  backdrop.offsetHeight;
  backdrop.style.opacity = '1';
  if (panel) { panel.style.transform = 'translateY(0)'; }
  _cinemaLoadFilms();
}

function _cinemaCloseLibrary() {
  var backdrop = $('cinemaLibraryBackdrop');
  var panel = $('cinemaLibrary');
  if (!backdrop) return;
  backdrop.style.opacity = '0';
  if (panel) { panel.style.transform = 'translateY(12px)'; }
  setTimeout(function() {
    if (backdrop.style.opacity === '0') {
      backdrop.style.display = 'none';
    }
  }, 300);
}

// =========== 事件绑定 ===========

function _cinemaBindEvents() {
  $('cinemaCloseBtn').onclick = function() {
    closeCinemaPanel();
    document.querySelectorAll('.home-nav-item').forEach(function(x) { x.classList.remove('active'); });
    var homeBtn = document.querySelector('[data-page="home"]');
    if (homeBtn) homeBtn.classList.add('active');
  };
  $('cinemaRefreshBtn').onclick = _cinemaLoadFilms;
  $('cinemaRescanBtn').onclick = _cinemaRescan;
  $('cinemaPlayUrlBtn').onclick = _cinemaPlayUrl;
  $('cinemaUrlInput').onkeydown = function(e) { if (e.key === 'Enter') _cinemaPlayUrl(); };

  $('cinemaChatSend').onclick = _cinemaSendChat;
  $('cinemaChatInput').onkeydown = function(e) { if (e.key === 'Enter') _cinemaSendChat(); };

  // 上传
  $('cinemaDropZone').onclick = function() { $('cinemaFileInput').click(); };
  $('cinemaFileInput').onchange = _cinemaHandleUpload;

  // 图片上传
  $('cinemaImageBtn').onclick = function() { $('cinemaImageInput').click(); };
  $('cinemaImageInput').onchange = _cinemaHandleImageUpload;

  // 拖拽
  var dz = $('cinemaDropZone');
  if (dz) {
    dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.style.borderColor = 'rgba(200,150,100,.4)'; });
    dz.addEventListener('dragleave', function() { dz.style.borderColor = 'rgba(255,255,255,.06)'; });
    dz.addEventListener('drop', function(e) {
      e.preventDefault();
      dz.style.borderColor = 'rgba(255,255,255,.06)';
      var file = e.dataTransfer.files[0];
      if (file && file.type.startsWith('video/')) {
        _cinemaUploadFile(file);
      }
    });
  }

  // 片库 — 居中浮动面板
  var libBtn = $('cinemaLibraryBtn');
  var libClose = $('cinemaLibraryCloseBtn');
  if (libBtn) { libBtn.onclick = _cinemaOpenLibrary; }
  if (libClose) { libClose.onclick = _cinemaCloseLibrary; }

  // 聊天面板切换
  var chatToggle = $('cinemaChatToggleBtn');
  var chatPanel = $('cinemaChatPanel');
  if (chatToggle && chatPanel) {
    chatToggle.onclick = function() {
      var isHidden = chatPanel.style.display === 'none';
      chatPanel.style.display = isHidden ? 'flex' : 'none';
      chatToggle.style.color = isHidden ? 'rgba(255,255,255,.4)' : 'rgba(200,150,100,.7)';
    };
  }

  // 收藏按钮（占位）
  var favBtn = $('cinemaFavBtn');
  if (favBtn) {
    favBtn.onclick = function() {
      favBtn.style.color = 'rgba(220,120,120,.7)';
      setTimeout(function() { favBtn.style.color = 'rgba(255,255,255,.4)'; }, 800);
    };
  }

  // B站扫码登录
  var biliBtn = $('cinemaBiliBtn');
  if (biliBtn) {
    biliBtn.onclick = showBilibiliLogin;
    // 检查登录状态，更新按钮颜色
    fetch('/api/bilibili/status')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.loggedIn && biliBtn) { biliBtn.style.color = 'rgba(150,200,180,.6)'; biliBtn.title = 'B站已登录'; }
      });
  }

  // 工具栏 hover 效果
  var toolBtns = document.querySelectorAll('.cinema-tool-btn');
  for (var i = 0; i < toolBtns.length; i++) {
    toolBtns[i].addEventListener('mouseenter', function() {
      this.style.background = 'rgba(255,255,255,.06)';
      this.style.color = 'rgba(255,255,255,.7)';
      this.style.transform = 'translateY(-2px)';
    });
    toolBtns[i].addEventListener('mouseleave', function() {
      this.style.background = 'rgba(20,18,28,.3)';
      this.style.color = 'rgba(255,255,255,.4)';
      this.style.transform = 'translateY(0)';
    });
  }

  // 视频播放时间更新 → 同步 OWC + 保存本地进度
  var v = $('cinemaVideo');
  if (v) {
    v.addEventListener('timeupdate', function() {
      if (_cinemaRoomId && v.currentTime) {
        _cinemaSyncPlayback(v.currentTime * 1000);
      }
      // 每 5 秒保存一次观看进度
      if (_cinemaCurrentFilm && v.currentTime && !v._lastProgressSave || (v.currentTime - (v._lastProgressSave || 0) > 5)) {
        v._lastProgressSave = v.currentTime;
        _cinemaSaveProgress(_cinemaCurrentFilm.id || _cinemaCurrentFilm.media_id, v.currentTime, v.duration || 0);
        // 证据层：每 5 秒上报一次播放状态
        if (v.currentTime && !v._lastStateReport || (v.currentTime - (v._lastStateReport || 0) > 5)) {
          v._lastStateReport = v.currentTime;
          _cinemaReportState(v);
        }
      }
    });
  }

  // 注入动画 CSS（仅一次）
  if (!document.getElementById('cinema-anim-style')) {
    var st = document.createElement('style');
    st.id = 'cinema-anim-style';
    st.textContent = '@keyframes cinemaCardIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}';
    document.head.appendChild(st);
  }
}

// =========== 电影库 ===========

