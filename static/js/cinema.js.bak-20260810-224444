function _cinemaDefaultBg() {
  return 'linear-gradient(170deg, #F7F5F2 0%, #F0EDEA 30%, #EDE9E5 60%, #F2EFEC 100%)';
}

// =========== 面板生命周期 ===========

function openCinemaPanel() {
  // 每次打开都重建，确保拿到最新 UI
  var old = $('cinemaPanel');
  if (old) { old.remove(); }
  var p = document.createElement('section');
  p.id = 'cinemaPanel'; p.setAttribute('aria-hidden', 'true');
  p.style.cssText = 'position:fixed;inset:0;z-index:80;display:none;flex-direction:column;color:#e0d5c1;overflow:hidden';
  p.innerHTML = _cinemaBuildHTML();
  document.body.appendChild(p);
  _cinemaBindEvents();
  $('cinemaPanel').style.display = 'flex';
  $('cinemaPanel').setAttribute('aria-hidden', 'false');
  _cinemaApplyBg();
  _cinemaLoadFilms();
  _cinemaRenderChat();
  _cinemaRefreshBiliStatus();
}

function closeCinemaPanel() {
  var p = $('cinemaPanel');
  if (p) { p.style.display = 'none'; p.setAttribute('aria-hidden', 'true'); }
  _cinemaStopPoll();
  var v = $('cinemaVideo');
  if (v) { v.pause(); v.src = ''; }
  var ifr = $('cinemaBilibiliIframe');
  if (ifr) ifr.src = '';
}

// =========== 背景 ===========

function _cinemaApplyBg() {
  var panel = $('cinemaPanel');
  if (!panel) return;
  if (_cinemaBgImage) {
    panel.style.background = 'url(' + _cinemaBgImage + ') center/cover no-repeat';
  } else {
    panel.style.background = _cinemaDefaultBg();
  }
}

// =========== 工具栏按钮生成器 ===========

