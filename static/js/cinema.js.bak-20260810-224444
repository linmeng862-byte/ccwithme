// =========== 进度追踪 ===========

function _cinemaGetProgress(filmId) {
  try {
    var raw = localStorage.getItem('cinema_progress_' + (filmId || ''));
    return raw ? JSON.parse(raw) : null;
  } catch(e) { return null; }
}

// 证据层：上报当前播放状态到后端
function _cinemaReportState(video) {
  if (!video) return;
  var film = _cinemaCurrentFilm || {};
  fetch('/api/cinema/state', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      title: film.title || '',
      bvid: _cinemaBvid || '',
      cid: _cinemaCid || '',
      currentTime: Math.round(video.currentTime || 0),
      duration: Math.round(video.duration || 0),
      source: _cinemaBvid ? 'bilibili' : 'local',
      sourceUrl: video.src || ''
    })
  }).catch(function() {});
}

// Cove 感官层：截取当前视频帧 → 发给千问 Vision 读硬字幕
function _cinemaCaptureFrame() {
  var video = $('cinemaVideo');
  if (!video || video.readyState < 2) return null;
  try {
    var canvas = document.createElement('canvas');
    canvas.width = video.videoWidth || 1280;
    canvas.height = video.videoHeight || 720;
    var ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    // 压缩到 720p 以内，减少传输体积
    if (canvas.width > 1280) {
      var ratio = 1280 / canvas.width;
      var small = document.createElement('canvas');
      small.width = 1280;
      small.height = Math.round(canvas.height * ratio);
      small.getContext('2d').drawImage(canvas, 0, 0, small.width, small.height);
      canvas = small;
    }
    return canvas.toDataURL('image/jpeg', 0.7);
  } catch(e) { return null; }
}

// 问这一幕 — 截帧 + 调用千问 Vision
function _cinemaAskScene(question) {
  var frame = _cinemaCaptureFrame();
  if (!frame) { _cinemaAddMessage('系统', '无法截取画面，请等视频开始播放后再问'); return; }
  var video = $('cinemaVideo');
  var t = video ? Math.round(video.currentTime) : 0;

  // 临时显示
  _cinemaAddMessage('系统', '正在看这一幕...');

  fetch('/api/cinema/sensory', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ frame: frame, timestamp: t, question: question || '' })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.error) { _cinemaAddMessage('系统', d.error); return; }
    _cinemaAddMessage('小克', d.text);
  }).catch(function(e) {
    _cinemaAddMessage('系统', '感官分析失败: ' + e.message);
  });
}

// 向聊天区添加消息
function _cinemaAddMessage(sender, text) {
  _cinemaMessages.push({ sender: sender, text: text, time: Date.now() });
  _cinemaRenderChat();
}

function _cinemaSaveProgress(filmId, currentTime, duration) {
  try {
    localStorage.setItem('cinema_progress_' + (filmId || ''), JSON.stringify({
      currentTime: currentTime,
      duration: duration,
      lastWatched: Date.now()
    }));
  } catch(e) {}
}

function _cinemaContinueFilm(idx) {
  var film = _cinemaFilmList[idx];
  if (film) {
    _cinemaPlayFilm(film);
    // 如果有保存的进度，等视频加载后跳转
    var progress = _cinemaGetProgress(film.id || film.media_id);
    if (progress && progress.currentTime) {
      var v = $('cinemaVideo');
      if (v) {
        var jump = function() {
          if (v.readyState >= 2) { v.currentTime = progress.currentTime; }
          else { setTimeout(jump, 300); }
        };
        setTimeout(jump, 500);
      }
    }
    _cinemaCloseLibrary();
  }
}

function _cinemaDeleteFilm(film) {
  if (!film) return;
  var id = film.id || film.media_id;
  // 清除进度
  try { localStorage.removeItem('cinema_progress_' + id); } catch(e) {}
  // 调用 OWC 删除
  fetch('/api/owc/api/media/' + id, { method: 'DELETE' }).catch(function() {});
}

// =========== 辅助 ===========

function _escHtml(s) {
  return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
