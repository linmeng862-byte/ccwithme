// =========== 播放 ===========

function _cinemaPlayFilm(film) {
  _cinemaHideAllPlayers();
  _cinemaCurrentFilm = film;

  // 更新卡片高亮
  _cinemaLoadFilms();

  // 播放本地视频
  var streamUrl = '/api/owc/api/stream/' + (film.id || film.media_id);
  var video = $('cinemaVideo');
  if (video) {
    video.src = streamUrl;
    video.style.display = 'block';
    video.play().catch(function() {});
    $('cinemaPlaceholder').style.display = 'none';
  }

  // 创建 OWC 房间
  _cinemaOpenRoom(film.id || film.media_id);
}

function _cinemaPlayUrl() {
  var url = ($('cinemaUrlInput').value || '').trim();
  if (!url) return;

  _cinemaHideAllPlayers();
  _cinemaCurrentFilm = null;
  _cinemaLoadFilms();
  _cinemaCloseRoom();

  if (/bilibili\.com|b23\.tv/i.test(url)) {
    _cinemaPlayBilibili(url);
  } else {
    var video = $('cinemaVideo');
    if (video) {
      video.src = url;
      video.style.display = 'block';
      video.play().catch(function() {});
      $('cinemaPlaceholder').style.display = 'none';
    }
  }
}

function _cinemaPlayBilibili(url) {
  var bvMatch = url.match(/BV[\w]{10}/i);
  var epMatch = url.match(/ep(\d+)/i);
  if (bvMatch) {
    _cinemaPlayBilibiliById(bvMatch[0], '');
  } else if (epMatch) {
    // 剧集链接 → 走解析获取 bvid + cid
    _cinemaParseAndPlay(url);
  } else {
    _cinemaParseAndPlay(url);
  }
}

function _cinemaParseAndPlay(url) {
  fetch('/api/cinema/parse', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ url: url })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.bvid) _cinemaPlayBilibiliById(d.bvid, d.cid || '');
    else _cinemaFallback('B站链接解析失败，试试直接贴 BV 号');
  }).catch(function() { _cinemaFallback('解析失败，试试直接贴 BV 号'); });
}

function _cinemaPlayBilibiliById(bvid, cid) {
  var qs = 'bvid=' + bvid + (cid ? '&cid=' + cid : '');
  // 先尝试通过后端 API 获取流地址（带 cookie，可播会员视频）
  fetch('/api/bilibili/playback?' + qs)
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.url) {
        // 有直链 → HTML5 播放器（走后端代理绕过 Referer）
        _cinemaHideAllPlayers();
        var video = $('cinemaVideo');
        if (video) {
          video.src = '/api/bilibili/stream?url=' + encodeURIComponent(d.url);
          video.style.display = 'block';
          video.play().catch(function() {});
          $('cinemaPlaceholder').style.display = 'none';
          // 建房间 — 一起看
          _cinemaCurrentFilm = { id: bvid, title: 'B站视频 ' + bvid };
          _cinemaOpenRoom(bvid);
          _cinemaBvid = bvid;
          _cinemaCid = d.cid || cid || '';
          // 立即上报一次状态
          setTimeout(function() { _cinemaReportState(video); }, 500);
        }
      } else {
        // 回退到嵌入式播放器
        _cinemaLoadBilibiliEmbed(bvid, 1);
      }
    })
    .catch(function() {
      // 网络错误 → 回退嵌入式
      _cinemaLoadBilibiliEmbed(bvid, 1);
    });
}

function _cinemaLoadBilibiliEmbed(bvid, page) {
  var iframe = $('cinemaBilibiliIframe');
  if (!iframe) return;
  iframe.src = '//player.bilibili.com/player.html?bvid=' + bvid + '&page=' + (page || 1) + '&high_quality=1&autoplay=1';
  iframe.style.display = 'block';
  iframe.onload = function() {
    $('cinemaPlaceholder').style.display = 'none';
  };
}

function _cinemaHideAllPlayers() {
  var v = $('cinemaVideo'); if (v) { v.pause(); v.src = ''; v.style.display = 'none'; }
  var ifr = $('cinemaBilibiliIframe'); if (ifr) { ifr.src = ''; ifr.style.display = 'none'; }
}

function _cinemaFallback(msg) {
  var ph = $('cinemaPlaceholder');
  if (ph) { ph.innerHTML = '<span style="font-size:14px;color:rgba(255,255,255,.4)">' + msg + '</span>'; ph.style.display = 'flex'; }
}

// =========== OWC 房间 ===========

function _cinemaOpenRoom(mediaId) {
  fetch('/api/owc/api/rooms/open', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ mediaId: String(mediaId) })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.room) {
      _cinemaRoomId = d.room.id;
      console.log('[cinema] room opened:', _cinemaRoomId);
    }
  }).catch(function(e) {
    console.error('[cinema] open room failed:', e);
  });
}

function _cinemaCloseRoom() {
  if (!_cinemaRoomId) return;
  fetch('/api/owc/api/rooms/' + _cinemaRoomId + '/end', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ mediaTimeMs: 0 })
  }).catch(function() {});
  _cinemaRoomId = null;
}

var _cinemaLastSync = 0;
function _cinemaSyncPlayback(ms) {
  if (!_cinemaRoomId || Math.abs(ms - _cinemaLastSync) < 3000) return;
  _cinemaLastSync = ms;
  fetch('/api/owc/api/rooms/' + _cinemaRoomId + '/playback', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ mediaTimeMs: Math.round(ms), playbackState: 'playing' })
  }).catch(function() {});
}

function _cinemaStopPoll() {
  if (_cinemaPollTimer) { clearInterval(_cinemaPollTimer); _cinemaPollTimer = null; }
}

// =========== 上传 ===========

function _cinemaHandleUpload() {
  var file = $('cinemaFileInput').files[0];
  if (file) _cinemaUploadFile(file);
}

function _cinemaUploadFile(file) {
  var status = $('cinemaStatus');
  if (status) status.textContent = '上传中…';
  var form = new FormData();
  form.append('file', file);
  fetch('/api/cinema/upload', { method: 'POST', body: form })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.url) {
        $('cinemaUrlInput').value = window.location.origin + d.url;
        _cinemaPlayUrl();
      }
      if (status) status.textContent = '上传完成';
    }).catch(function() {
      if (status) status.textContent = '上传失败';
    });
}

// =========== 图片上传 ===========

function _cinemaHandleImageUpload() {
  var file = $('cinemaImageInput').files[0];
