// =========== 聊天 ===========

function _cinemaRenderChat() {
  var list = $('cinemaChatList');
  if (!list) return;
  if (_cinemaMessages.length === 0) {
    list.innerHTML = '<div style="text-align:center;padding:24px;color:rgba(255,255,255,.12);font:300 14px/1.6 var(--font-sans)">这一刻想聊点什么…</div>';
    return;
  }
  list.innerHTML = '';
  for (var i = 0; i < _cinemaMessages.length; i++) {
    var m = _cinemaMessages[i];
    var isMe = m.sender === '小克' || m.sender === 'Claude';
    var el = document.createElement('div');
    el.style.cssText = 'display:flex;flex-direction:column;gap:3px;line-height:1.8;padding:4px 0';
    // 发送者名 — 小的提示
    var nameEl = document.createElement('span');
    nameEl.style.cssText = 'font-weight:500;font-size:11px;letter-spacing:.03em;color:' +
      (isMe ? 'rgba(200,160,120,.5)' : 'rgba(180,160,220,.5)') + ';text-transform:uppercase';
    nameEl.textContent = m.sender;
    // 消息正文 — 大字体段落
    var textEl = document.createElement('p');
    textEl.style.cssText = 'margin:0;font:300 15px/1.75 var(--font-sans);color:rgba(255,255,255,.72);letter-spacing:.01em;' +
      (isMe ? 'border-left:2px solid rgba(200,150,120,.2);padding-left:14px;' : '');
