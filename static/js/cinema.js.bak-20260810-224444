}

function _cinemaSendChat() {
  var input = $('cinemaChatInput');
  var text = (input.value || '').trim();
  if (!text) return;

  var name = (window._viewerName || localStorage.getItem('chatc_name') || '我').trim();
  _cinemaMessages.push({ sender: name, text: text, time: Date.now() });
  input.value = '';
  _cinemaRenderChat();

  // 转发到 Chat-C 主聊天
  if (typeof appendChatMessage === 'function') {
    appendChatMessage({ role: 'user', content: '[影院] ' + text });
  }
  // 如果有 OWC 房间，也发到房间消息
  if (_cinemaRoomId) {
    var video = $('cinemaVideo');
    var currentMs = video ? Math.round(video.currentTime * 1000) : 0;
    fetch('/api/owc/api/rooms/' + _cinemaRoomId + '/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ senderName: name, content: text, mediaTimeMs: currentMs })
    }).catch(function() {});
  }
}

